{
  "name": "pigeongraph",
  "version": "1.0.6",
  "description": "Unified multi-layer code knowledge graph for AI coding agents combining real-time OS file monitoring, dynamic dispatch synthesis, and async multimodal document intelligence.",
  "author": "MD. Mahinur Rahman Prachurza (Hoppy-Beast)",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hoppy-Beast/pigeongraph.git"
  },
  "bugs": {
    "url": "https://github.com/Hoppy-Beast/pigeongraph/issues"
  },
  "homepage": "https://github.com/Hoppy-Beast/pigeongraph#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "code-knowledge-graph",
    "ast",
    "code-intelligence",
    "ai-agents",
    "claude",
    "cursor",
    "antigravity",
    "gemini",
    "codebase-exploration",
    "blast-radius"
  ],
  "workspaces": [
    "packages/*"
  ],
  "files": [
    "dist",
    "templates",
    "LICENSE",
    "README.md"
  ],
  "bin": {
    "pigeongraph": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -b && node build.js",
    "test": "npm run test:all",
    "test:all": "tsx --test packages/*/test/**/*.test.ts",
    "bench": "tsx packages/pigeongraph-mcp/eval/run-eval.ts",
    "setup": "npm install && npm run build && npm link",
    "install:global": "npm install && npm run build && npm install -g .",
    "uninstall:global": "npm unlink -g pigeongraph"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "graphology": "^0.26.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.10",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
